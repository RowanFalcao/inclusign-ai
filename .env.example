# ==============================================================================
# IncluSign AI — Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# ==============================================================================

# ------------------------------------------------------------------------------
# Servidor Web e API
# ------------------------------------------------------------------------------
INCLUSIGN_PORT=5000
INCLUSIGN_HOST=127.0.0.1
INCLUSIGN_DEBUG=False

# ------------------------------------------------------------------------------
# Provedor LLM Local (Ollama)
# ------------------------------------------------------------------------------
INCLUSIGN_OLLAMA_URL=http://127.0.0.1:11434
INCLUSIGN_OLLAMA_MODEL=qwen3:4b
INCLUSIGN_LLM_TIMEOUT=120
INCLUSIGN_LLM_TEMPERATURE=0.4
INCLUSIGN_LLM_MAX_TOKENS=8192
INCLUSIGN_LLM_MAX_CONTEXT=8192
INCLUSIGN_LLM_REPEAT_LAST_N=64

# ------------------------------------------------------------------------------
# Banco Vetorial (Qdrant & Embeddings)
# ------------------------------------------------------------------------------
INCLUSIGN_EMBEDDING_MODEL=all-MiniLM-L6-v2
INCLUSIGN_VECTOR_COLLECTION=inclusign_knowledge
INCLUSIGN_RAG_CHUNK_SIZE=800
INCLUSIGN_RAG_CHUNK_OVERLAP=150
INCLUSIGN_RAG_TOP_K=3

